cabal-version:       2.4
-- Initial package description 'rebac.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:                rebac
version:             0.1.0.0
synopsis:            Relationship Based Access Control
-- description:
-- bug-reports:
license:             BSD-3-Clause
license-file:        LICENSE
author:              Jeremy Shaw
maintainer:          jeremy@seereason.com
-- copyright:
category:            Web
extra-source-files:  CHANGELOG.md rebac.el

library
  exposed-modules:
                       AccessControl.Check
                       AccessControl.Relation
                       AccessControl.Schema
  -- other-modules:
  -- other-extensions:
  build-depends:       base ^>=4.12.0.0,
                       containers,
                       megaparsec >= 7.0 && < 9.8,
                       mtl,
                       pretty ^>=1.1.3.6,
                       safecopy,
                       text ^>=1.2,
                       template-haskell,
                       th-lift-instances,
                       userid
  hs-source-dirs:      src
  default-language:    Haskell2010

test-suite Test
  Default-Language : Haskell2010
  type             : exitcode-stdio-1.0
  main-is          : Test.hs
  hs-source-dirs   : test
  build-depends    : acid-state,
                     base == 4.*,
                     HUnit,
                     hspec,
                     QuickCheck,
                     text,
                     rebac
